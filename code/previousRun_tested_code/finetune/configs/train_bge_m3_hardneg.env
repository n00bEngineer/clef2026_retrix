# Baseline hard-negative fine-tuning config for the repo BGE-M3 retriever.

MODEL_NAME=BAAI/bge-m3
TRAIN_DATA=$REPO_ROOT/code/data/finetune/flagembedding/train_hardneg.jsonl
OUTPUT_DIR=$REPO_ROOT/models/ft_bge_m3_hardneg

QUERY_MAX_LEN=128
PASSAGE_MAX_LEN=512
TRAIN_GROUP_SIZE=16
LEARNING_RATE=1e-5
NUM_TRAIN_EPOCHS=1
PER_DEVICE_BATCH_SIZE=2
WARMUP_RATIO=0.1
LOGGING_STEPS=10
SAVE_STEPS=500
NEGATIVES_CROSS_DEVICE=True
USE_SELF_DISTILL=True
SELF_DISTILL_START_STEP=0
FIX_ENCODER=False
KNOWLEDGE_DISTILLATION=False
USE_DEEPSPEED=auto

RUN_EVAL_AFTER_TRAIN=False
COMPARE_TO_BASELINE_AFTER_TRAIN=True
BASELINE_MODEL=BAAI/bge-m3
BASELINE_LABEL=baseline_bge_m3
CANDIDATE_LABEL=ft_bge_m3_hardneg

EVAL_QUERIES=$REPO_ROOT/code/data/finetune/repo/dev_queries.json
EVAL_CORPUS=$REPO_ROOT/code/data/collection_data.json
EVAL_QUERY_FIELD=expanded
EVAL_RETRIEVAL_MODE=hybrid
EVAL_TOP_K=100
EVAL_BATCH_SIZE=128
EVAL_CPU_THREADS=6
EVAL_CANDIDATE_MULTIPLIER=2
EVAL_HYBRID_MAX_LENGTH=256
EVAL_COLBERT_SCORE_BATCH_SIZE=512
EVAL_DENSE_WEIGHT=0.4
EVAL_SPARSE_WEIGHT=0.2
EVAL_COLBERT_WEIGHT=0.4
EVAL_PRECOMPUTE_CORPUS_HYBRID=False
EVAL_CORPUS_COLBERT_DTYPE=float16
EVAL_LOG_EVERY_QUERIES=100
